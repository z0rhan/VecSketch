shape bbox = +[10,10]-[10,-10]-[-10,-10]-[-10,10]-[10,10]
shape point = [10,0]
shape spiral = point
shape newpoint = point
shape segment = point
number red = 255

draw bbox (255,255,255)
while 2 < point.x*point.x + point.y*point.y is
    newpoint := (point / 10) * (99/100)
    segment := +(point + newpoint)
    draw segment (red, 255-red, 0)
    wait 1/30
    red := red * (99/100)
    spiral := spiral + segment
    point := newpoint
endwhile
pause
draw -spiral (0, 0, 255)
pause
